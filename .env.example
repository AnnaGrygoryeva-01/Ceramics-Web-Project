# Copy to .env and fill in. This repo is public, so real values must never be committed.

# Only for ./build-push.sh
DOCKERHUB_USERNAME=
DOCKERHUB_TOKEN=

# Only for ./deploy.sh. Leave the token out if doctl is already logged in on this machine.
DIGITALOCEAN_ACCESS_TOKEN=

# The site. ./deploy.sh sends everything in this group to App Platform.
DATABASE_URL=libsql://your-database.turso.io
DATABASE_TOKEN=

# Stripe (Developers > API keys). Test keys (pk_test_, sk_test_) until the shop goes
# live. The webhook secret comes from `stripe listen` locally, or the Dashboard's
# webhook endpoint for https://annagryceramics.com/api/stripe/webhook.
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Where Stripe sends customers back to after paying
SITE_URL=https://annagryceramics.com
