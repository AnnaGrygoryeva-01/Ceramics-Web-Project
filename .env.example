# Copy to .env and fill in. This repo is public, so real values must never be committed.

# The site. Everything in this group is sent to App Platform.
DATABASE_URL=libsql://your-database.turso.io
DATABASE_TOKEN=

# Only for ./deploy.sh, these never reach the running app. Leave them out if this
# machine is already logged in to Docker Hub and doctl.
DOCKERHUB_USERNAME=
DOCKERHUB_TOKEN=
DIGITALOCEAN_ACCESS_TOKEN=
